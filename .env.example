# Copy this file to .env and fill in your own values. Never commit .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-key
ADMIN_API_KEY=pick-a-long-random-string
DEFAULT_MONTHLY_LIMIT_USD=0.01

# "mock" runs without any API key. Set to "gemini" to call the real model.
LLM_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# USD per 1 million tokens (check ai.google.dev/pricing)
PRICE_INPUT_PER_M=0.30
PRICE_OUTPUT_PER_M=2.50